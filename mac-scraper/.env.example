# ── Toronto Ticket Tracker — Mac Scraper Config ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore already).

# GitHub Personal Access Token — needed for auto git push after each scrape.
# Create one at: GitHub → Settings → Developer Settings → Personal Access Tokens
#   → Tokens (classic) → Generate new token → tick "repo" scope → copy it here.
GITHUB_TOKEN=your_github_personal_access_token_here

# SeatGeek Client ID (optional but recommended — gives better price data).
# Get one free at: https://seatgeek.com/account/develop
# Leave blank to use Puppeteer scraping for SeatGeek instead.
SEATGEEK_CLIENT_ID=
